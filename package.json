{
  "name": "remotectrl",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "pnpm --filter @remotectrl/api-server dev",
    "build:server": "pnpm --filter @remotectrl/api-server build",
    "typecheck": "pnpm --filter @remotectrl/api-zod typecheck && pnpm --filter @remotectrl/api-server typecheck",
    "test": "pnpm --filter @remotectrl/api-server test",
    "lint": "pnpm --filter @remotectrl/api-zod lint && pnpm --filter @remotectrl/api-server lint",
    "build": "pnpm --filter @remotectrl/api-server build"
  }
}
